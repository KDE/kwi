Keywords[ar]=طرفية;صدفة;طرفية نصية;أمر;
Keywords[ca]=terminal;shell;consola;ordre;intèrpret;
Keywords[ca@valencia]=terminal;shell;consola;ordre;intèrpret;
Keywords[cs]=terminál;shell;konzole;příkaz;
Keywords[es]=terminal;intérprete;consola;comando;orden;comandos;órdenes;
