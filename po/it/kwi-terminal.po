#: libs/kwi-terminal/src/TitleFormat.cpp:22
#, kde-format
msgid "Enter a title format."
msgstr "Digita un formato per il titolo."

#: libs/kwi-terminal/src/TitleFormat.cpp:28
#, kde-format
msgid "Title formats can contain at most 256 characters."
msgstr "I formati dei titoli possono contenere al massimo 256 caratteri."

#: libs/kwi-terminal/src/TitleFormat.cpp:41
#, kde-format
msgid "Title formats cannot contain control characters."
msgstr "I formati dei titoli non possono contenere caratteri di controllo."

#: libs/kwi-terminal/src/TitleFormat.cpp:56
#, kde-format
msgid "Close each placeholder with }. Use {{ and }} for literal braces."
msgstr ""
"Chiudi ogni segnaposto con }. Usa {{ e }} per indicare le parentesi graffe "
"letterali."

#: libs/kwi-terminal/src/TitleFormat.cpp:93
#, kde-format
msgid "Unknown title placeholder: {%1}"
msgstr "Segnaposto per titolo sconosciuto: {%1}"

#: libs/kwi-terminal/src/TitleFormat.cpp:101
#, kde-format
msgid "Use }} for a literal closing brace."
msgstr "Usa }} per una parentesi graffa di chiusura letterale."
