<component type="desktop-application">
  <id>@KWI_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@KWI_PROJECT_LICENSE@</project_license>
  <name>@KWI_DISPLAY_NAME@</name>
  <name xml:lang="ar">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="ca">Terminal @KWI_DISPLAY_NAME@</name>
  <name xml:lang="ca-valencia">Terminal @KWI_DISPLAY_NAME@</name>
  <name xml:lang="cs">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="es">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="he">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="it">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="nl">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="nn">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="pt-BR">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="sk">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="sr">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="sr-Latn">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="sr-ijekavian">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="sr-ijekavianlatin">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="tr">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="uk">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="zh-CN">@KWI_DISPLAY_NAME@</name>
  <name xml:lang="zh-TW">@KWI_DISPLAY_NAME@</name>
  <developer id="@KWI_APP_ID@">
    <name>Kwi contributors</name>
  </developer>
  <summary>A modern and fast terminal</summary>
  <summary xml:lang="ar">طرفية حديثة وسريعة</summary>
  <summary xml:lang="ca">Un terminal modern i ràpid</summary>
  <summary xml:lang="ca-valencia">Un terminal modern i ràpid</summary>
  <summary xml:lang="cs">Moderní a rychlý terminál</summary>
  <summary xml:lang="es">Un terminal moderno y rápido</summary>
  <summary xml:lang="he">מסוף עדכני ומהיר</summary>
  <summary xml:lang="it">Un terminale moderno e veloce</summary>
  <summary xml:lang="nl">Een moderne en snelle terminal</summary>
  <summary xml:lang="nn">Ein moderne og rask terminal</summary>
  <summary xml:lang="pt-BR">Um terminal moderno e rápido</summary>
  <summary xml:lang="sk">Moderný a rýchly terminál</summary>
  <summary xml:lang="sr">Модеран и брз терминал</summary>
  <summary xml:lang="sr-Latn">Moderan i brz terminal</summary>
  <summary xml:lang="sr-ijekavian">Модеран и брз терминал</summary>
  <summary xml:lang="sr-ijekavianlatin">Moderan i brz terminal</summary>
  <summary xml:lang="tr">Çağdaş ve hızlı bir uçbirim</summary>
  <summary xml:lang="uk">Сучасний і швидкий термінал</summary>
  <summary xml:lang="zh-CN">一款现代化且响应快速的终端应用</summary>
  <summary xml:lang="zh-TW">現代且高效能的終端機</summary>
  <description>
    <p>Kwi is a modern and fast terminal that integrates well with KDE Plasma and other free desktops.</p>
    <p xml:lang="ar">كوي هو محاكي طرفية عصري وسريع، يتكامل بشكل جيد مع بيئة كيدي بلازما وغيرها من بيئات سطح المكتب الحرة.</p>
    <p xml:lang="ca">El Kwi és un terminal modern i ràpid que s'integra bé amb el Plasma de KDE i altres escriptoris lliures.</p>
    <p xml:lang="ca-valencia">Kwi és un terminal modern i ràpid que s'integra bé amb Plasma de KDE i altres escriptoris lliures.</p>
    <p xml:lang="cs">Kwi je moderní a rychlý terminál, který se dobře integruje do prostředí KDE Plasma a dalších svobodných desktopových prostředí.</p>
    <p xml:lang="es">Kwi es un terminal moderno y rápido que se integra bien con KDE Plasma y otros escritorios libres.</p>
    <p xml:lang="he">Kwi הוא מסוף עדכני ומהיר שמשתלב היטב עם פלזמה מבית KDE ושולחנות עבודה חופשיים נוספים.</p>
    <p xml:lang="it">Kwi è un terminale moderno e veloce che si integra bene con KDE Plasma e altri desktop liberi.</p>
    <p xml:lang="nl">Kwi is een moderne en snelle terminal die goed integreert met KDE Plasma en andere vrije bureaubladen.</p>
    <p xml:lang="pt-BR">Kwi é um terminal moderno e rápido que se integra bem ao KDE Plasma e a outros ambientes de desktop livres.</p>
    <p xml:lang="sk">Kwi je moderný a rýchly terminál, ktorý sa dobre začleňuje do KDE Plasma a ďalších slobodných prostredí.</p>
    <p xml:lang="sr">Kwi је модеран и брз терминал који се добро уклапа у КДЕ Плазму и друге слободне површи.</p>
    <p xml:lang="sr-Latn">Kwi je moderan i brz terminal koji se dobro uklapa u KDE Plasmu i druge slobodne površi.</p>
    <p xml:lang="sr-ijekavian">Kwi је модеран и брз терминал који се добро уклапа у КДЕ Плазму и друге слободне површи.</p>
    <p xml:lang="sr-ijekavianlatin">Kwi je moderan i brz terminal koji se dobro uklapa u KDE Plasmu i druge slobodne površi.</p>
    <p xml:lang="tr">Kwi; KDE Plasma ve diğer özgür masaüstleri ile pek iyi tümleşen, çağdaş ve hızlı bir uçbirimdir.</p>
    <p xml:lang="uk">Kwi — сучасний і швидкий термінал, який добре вписується у Плазму KDE та інші вільні стільничні середовища.</p>
    <p xml:lang="zh-CN">Kwi 是一款现代且快速的终端，能够很好地与 KDE Plasma 及其他自由桌面环境集成。</p>
    <p xml:lang="zh-TW">Kwi 是一個現代化、高效能，且與 KDE Plasma 及其他自由桌面整合的終端機。</p>
  </description>
  <url type="homepage">https://apps.kde.org/kwi/</url>
  <url type="vcs-browser">https://invent.kde.org/utilities/kwi</url>
  <url type="bugtracker">https://bugs.kde.org/enter_bug.cgi?product=kwi</url>
  <custom>
    <value key="KDE::matrix">#kwi:kde.org</value>
  </custom>
  <launchable type="desktop-id">@KWI_APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://cdn.kde.org/screenshots/kwi/kwi.png</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>@KWI_EXECUTABLE@</binary>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <recommends>
    <display_length compare="ge">600</display_length>
  </recommends>
  <translation type="gettext">@KWI_EXECUTABLE@</translation>
  <releases>
    <release version="0.1.0" date="2026-11-20" type="stable">
      <description>
        <p>Initial release.</p>
        <p xml:lang="ca">Versió inicial.</p>
        <p xml:lang="ca-valencia">Versió inicial.</p>
        <p xml:lang="cs">Úvodní vydání.</p>
        <p xml:lang="es">Lanzamiento inicial.</p>
        <p xml:lang="he">מהדורה ראשונית.</p>
        <p xml:lang="it">Rilascio iniziale.</p>
        <p xml:lang="nl">Initiële uitgave.</p>
        <p xml:lang="pt-BR">Versão inicial.</p>
        <p xml:lang="tr">İlk yayım</p>
        <p xml:lang="uk">Початковий випуск.</p>
        <p xml:lang="zh-CN">初始版本。</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
