#: libs/kwi-terminal/src/OutputSaveJob.cpp:105
#: libs/kwi-terminal/src/OutputSaveJob.cpp:138
#, kde-format
msgid "Could not read terminal output."
msgstr "ტერმინალში გამოტანილის წაკითხვა შეუძლებელია."

#: libs/kwi-terminal/src/OutputSaveJob.cpp:132
#, kde-format
msgid "This terminal is no longer available."
msgstr "ეს ტერმინალი ხელმისაწვდომი აღარაა."

#: libs/kwi-terminal/src/OutputSaveJob.cpp:135
#, kde-format
msgid "The terminal history changed while saving output."
msgstr "ტერმინალის ისტორია გამონატანის შენახვისას შეიცვალა."

#: libs/kwi-terminal/src/process/AttachedProcess.cpp:25
#, kde-format
msgid "Could not attach to an invalid terminal descriptor."
msgstr "არასწორ ტერმინალის დესკრიპტორზე მიმაგრება შეუძლებელია."

#: libs/kwi-terminal/src/process/AttachedProcess.cpp:37
#: libs/kwi-terminal/src/process/ProcessController.cpp:21
#, kde-format
msgid "Could not attach to the terminal: %1"
msgstr "ტერმინალზე მიმაგრება შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:163
#: libs/kwi-terminal/src/process/NativeProcess.cpp:121
#, kde-format
msgid "Could not create a terminal: %1"
msgstr "ტერმინალის შექმნა შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:303
#, kde-format
msgid "Could not start the host terminal query."
msgstr "ჰოსტის ტერმინალის მოთხოვნის გაშვება შეუძლებელია."

#: libs/kwi-terminal/src/process/HostProcess.cpp:303
#, kde-format
msgid "Could not start a host helper: %1"
msgstr "ჰოსტის დამხმარის გაშვება შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:309
#, kde-format
msgid "Could not find the system shell on the host."
msgstr "ჰოსტზე სისტემური ზარის პოვნა შეუძლებელია."

#: libs/kwi-terminal/src/process/HostProcess.cpp:310
#, kde-format
msgid "Could not find the terminal command on the host: %1"
msgstr "ჰოსტზე ტერმინალის ბრძანების პოვნა შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:354
#, kde-format
msgid "Could not start the host terminal command: %1"
msgstr "ჰოსტის ტერმინალის ბრძანების გაშვება შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/NativeProcess.cpp:142
#, kde-format
msgid "Could not find executable: %1"
msgstr "გამშვები ფაილის პოვნა შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/NativeProcess.cpp:183
#, kde-format
msgid "Could not run the terminal command: %1"
msgstr "ტერმინალის ბრძანების გაშვება შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/PtyProcess.cpp:67
#, kde-format
msgid "A terminal process is already running."
msgstr "ტერმინალის პროცესი უკვე გაშვებულია."

#: libs/kwi-terminal/src/process/PtyProcess.cpp:159
#, kde-format
msgid ""
"The terminal input queue is full. Wait for the running program before "
"pasting more text."
msgstr ""
"ტერმინალის შეყვანის რიგი სავსეა. მეტი ტექსტის ჩასმამდე დაელოდეთ გაშვებულ "
"პროგრამას."

#: libs/kwi-terminal/src/process/PtyProcess.cpp:190
#, kde-format
msgid "Could not write to the terminal: %1"
msgstr "ტერმინალში ჩაწერა შეუძლებელია: %1"

#: libs/kwi-terminal/src/process/PtyProcess.cpp:271
#, kde-format
msgid "Could not resize the terminal: %1"
msgstr "ტერმინალის ზომის შეცვლა შეუძლებელია: %1"

#: libs/kwi-terminal/src/ProcessLaunch.cpp:41
#, kde-format
msgid "A terminal's initial directory must be an absolute path."
msgstr "ტერმინალის საწყისი საქაღალდე აბსოლუტურ ბილიკს უნდა წარმოადგენდეს."

#: libs/kwi-terminal/src/ProcessLaunch.cpp:47
#, kde-format
msgid "The command contains a null character."
msgstr "ბრძანება ნულოვან სიმბოლოს შეიცავს."

#: libs/kwi-terminal/src/ProcessLaunch.cpp:59
#: libs/kwi-terminal/src/ProcessLaunch.cpp:64
#: libs/kwi-terminal/src/Session.cpp:223
#, kde-format
msgid "The terminal environment contains an invalid assignment."
msgstr "ტერმინალის გარემო არასწორ მინიჭებას შეიცავს."

#: libs/kwi-terminal/src/Session.cpp:30
#, kde-format
msgid "Could not allocate terminal state."
msgstr "ტერმინალის მდგომარეობის გამოყოფა შეუძლებელია."

#: libs/kwi-terminal/src/Session.cpp:32
#, kde-format
msgid "Could not capture terminal render state."
msgstr "ტერმინალის რენდერის მდგომარეობის ჩაჭერა შეუძლებელია."

#: libs/kwi-terminal/src/Session.cpp:42 libs/kwi-terminal/src/Session.cpp:264
#: libs/kwi-terminal/src/TerminalAccessible.cpp:146
#, kde-format
msgid "Terminal"
msgstr "ტერმინალი"

#: libs/kwi-terminal/src/Session.cpp:388
#, kde-format
msgid "Program '%1' crashed."
msgstr "პროგრამა %1 ავარიულად დასრულდა."

#: libs/kwi-terminal/src/Session.cpp:671
#, kde-format
msgid "Could not resize the terminal."
msgstr "ტერმინალის ზომის შეცვლა შეუძლებელია."

#: libs/kwi-terminal/src/Session.cpp:694
#, kde-format
msgid "The terminal could not process output."
msgstr "ტერმინალში გამოტანილის დამუშავება შეუძლებელია."

#: libs/kwi-terminal/src/TerminalAccessible.cpp:144
#, kde-format
msgid "Terminal: %1"
msgstr "ტერმინალი: %1"

#: libs/kwi-terminal/src/TerminalAccessible.cpp:156
#, kde-format
msgid "Terminal output. Use keyboard selection mode to review and copy text."
msgstr ""
"ტერმინალის გამოტანა. ტექსტის გადასახედად და დასაკოპირებლად გამოიყენეთ "
"კლავიატურის მონიშვნის რეჟიმი."

#: libs/kwi-terminal/src/TerminalSearch.cpp:209
#, kde-format
msgid "No matches"
msgstr "დათხვევა არ არსებობს"

#: libs/kwi-terminal/src/TerminalSearch.cpp:211
#, kde-format
msgid "%1 of %2"
msgstr "%1 %2-დან"

#: libs/kwi-terminal/src/TerminalSearch.cpp:213
#, kde-format
msgid "%1 match"
msgid_plural "%1 matches"
msgstr[0] "%1 დამთხვევა"
msgstr[1] "%1 დამთხვევა"

#: libs/kwi-terminal/src/TerminalSearch.cpp:232
#, kde-format
msgid "Could not search terminal history"
msgstr "ტერმინალის ისტორიაში ძებნა შეუძლებელია"

#: libs/kwi-terminal/src/TitleFormat.cpp:22
#, kde-format
msgid "Enter a title format."
msgstr "შეიყვანეთ სათაურის ფორნატი."

#: libs/kwi-terminal/src/TitleFormat.cpp:28
#, kde-format
msgid "Title formats can contain at most 256 characters."
msgstr "სათაურის ფორმატი მაქს. 256 სიმბოლოს შეიძლება, შეიცავდეს."

#: libs/kwi-terminal/src/TitleFormat.cpp:41
#, kde-format
msgid "Title formats cannot contain control characters."
msgstr "სათაურის ფორმატი არ შეიძლება, საკონტროლო სიმბოლოებს შეიცავდეს."

#: libs/kwi-terminal/src/TitleFormat.cpp:56
#, kde-format
msgid "Close each placeholder with }. Use {{ and }} for literal braces."
msgstr ""
"დახურეთ თითოეული ადგილმჭერი }-ით. გამოიყენეთ {{ და }} ფრჩხილის "
"სიმბოლოებისთვის."

#: libs/kwi-terminal/src/TitleFormat.cpp:93
#, kde-format
msgid "Unknown title placeholder: {%1}"
msgstr "უცნობი სათაურის ადგილმჭერი: {%1}"

#: libs/kwi-terminal/src/TitleFormat.cpp:101
#, kde-format
msgid "Use }} for a literal closing brace."
msgstr "დამხურავი ფრჩხილისთვის გამოიყენეთ }}."
