#: libs/kwi-terminal/src/OutputSaveJob.cpp:105
#: libs/kwi-terminal/src/OutputSaveJob.cpp:138
#, kde-format
msgid "Could not read terminal output."
msgstr "Não foi possível ler a saída do terminal."

#: libs/kwi-terminal/src/OutputSaveJob.cpp:132
#, kde-format
msgid "This terminal is no longer available."
msgstr "Este terminal não está mais disponível."

#: libs/kwi-terminal/src/OutputSaveJob.cpp:135
#, kde-format
