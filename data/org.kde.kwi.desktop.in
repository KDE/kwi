[Desktop Entry]
Type=Application
Name=@KWI_DISPLAY_NAME@
Name[ca]=@KWI_DISPLAY_NAME@
Name[ca@valencia]=@KWI_DISPLAY_NAME@
Name[nl]=@KWI_DISPLAY_NAME@
Name[pt_BR]=@KWI_DISPLAY_NAME@
Name[sr]=@KWI_DISPLAY_NAME@
Name[sr@ijekavian]=@KWI_DISPLAY_NAME@
Name[sr@ijekavianlatin]=@KWI_DISPLAY_NAME@
Name[sr@latin]=@KWI_DISPLAY_NAME@
Name[tr]=@KWI_DISPLAY_NAME@
Name[uk]=@KWI_DISPLAY_NAME@
GenericName=Terminal
GenericName[ca]=Terminal
GenericName[ca@valencia]=Terminal
GenericName[nl]=Terminal
GenericName[pt_BR]=Terminal
GenericName[sr]=Терминал
GenericName[sr@ijekavian]=Терминал
GenericName[sr@ijekavianlatin]=Terminal
GenericName[sr@latin]=Terminal
GenericName[tr]=Uçbirim
GenericName[uk]=Термінал
Comment=A modern and fast terminal
Comment[ca]=Un terminal modern i ràpid
Comment[ca@valencia]=Un terminal modern i ràpid
Comment[nl]=Een moderne en snelle terminal
Comment[pt_BR]=Um terminal moderno e rápido
Comment[sr]=Модеран и брз терминал
Comment[sr@ijekavian]=Модеран и брз терминал
Comment[sr@ijekavianlatin]=Moderan i brz terminal
Comment[sr@latin]=Moderan i brz terminal
Comment[tr]=Çağdaş ve hızlı bir uçbirim
Comment[uk]=Сучасний і швидкий термінал
Exec=@KWI_EXECUTABLE@
TryExec=@KWI_EXECUTABLE@
Icon=@KWI_APP_ID@
Terminal=false
Categories=Qt;KDE;System;TerminalEmulator;
Keywords=terminal;shell;console;command;
Keywords[ca]=terminal;shell;consola;ordre;intèrpret;
Keywords[ca@valencia]=terminal;shell;consola;ordre;intèrpret;
Keywords[pt_BR]=terminal;shell;console;comando;
Keywords[sr]=terminal;shell;console;command;терминал;шкољка;конзола;наредба;
Keywords[sr@ijekavian]=terminal;shell;console;command;терминал;шкољка;конзола;наредба;
Keywords[sr@ijekavianlatin]=terminal;shell;console;command;terminal;školjka;konzola;naredba;
Keywords[sr@latin]=terminal;shell;console;command;terminal;školjka;konzola;naredba;
Keywords[tr]=terminal;uçbirim;uç birim;konsol;komut;console;command;
Keywords[uk]=terminal;shell;console;command;термінал;оболонка;консоль;команда;
StartupNotify=true
StartupWMClass=@KWI_EXECUTABLE@
X-GNOME-UsesNotifications=true
X-KDE-AuthorizeAction=shell_access
X-KDE-Shortcuts=Ctrl+Alt+T
Actions=NewWindow;NewTab;

[Desktop Action NewWindow]
Name=New Window
Name[ca]=Finestra nova
Name[ca@valencia]=Finestra nova
Name[nl]=Nieuw venster
Name[pt_BR]=Nova janela
Name[sr]=Нови прозор
Name[sr@ijekavian]=Нови прозор
Name[sr@ijekavianlatin]=Novi prozor
Name[sr@latin]=Novi prozor
Name[tr]=Yeni Pencere
Name[uk]=Нове вікно
Icon=window-new
Exec=@KWI_EXECUTABLE@

[Desktop Action NewTab]
Name=New Tab
Name[ca]=Pestanya nova
Name[ca@valencia]=Pestanya nova
Name[nl]=Nieuw tabblad
Name[pt_BR]=Nova aba
Name[sr]=Нови језичак
Name[sr@ijekavian]=Нови језичак
Name[sr@ijekavianlatin]=Novi jezičak
Name[sr@latin]=Novi jezičak
Name[tr]=Yeni Sekme
Name[uk]=Нова вкладка
Icon=tab-new
Exec=@KWI_EXECUTABLE@ --new-tab
