{
    "id": "org.kde.kwi",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kwi",
    "finish-args": [
        "--device=all",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--filesystem=home:ro",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.kglobalaccel"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/mkspecs",
        "/share/doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libghostty-vt",
            "buildsystem": "simple",
            "build-commands": [
                "ZIG_GLOBAL_CACHE_DIR=\"$PWD/zig-cache\" ./zig/zig build --system \"$PWD/zig-packages\" -Doptimize=ReleaseFast -Dcpu=baseline --prefix /app",
                "install -Dm644 LICENSE deps/libghostty-vt-third-party.json -t /app/share/licenses/libghostty-vt",
                "install -Dm644 zig/LICENSE /app/share/licenses/libghostty-vt/zig/LICENSE",
                "install -Dm644 zig/lib/libc/musl/COPYRIGHT /app/share/licenses/libghostty-vt/zig/musl-COPYRIGHT",
                "install -Dm644 pkg/simdutf/vendor/LICENSE* -t /app/share/licenses/libghostty-vt/simdutf",
                "sed -n '/^\\/\\* From$/,/^\\*\\//p' pkg/simdutf/vendor/simdutf.h > /app/share/licenses/libghostty-vt/simdutf/ISA-DETECTION-NOTICE",
                "install -Dm644 zig-packages/uucode-0.2.0-ZZjBPm6FVgBcY-79AHV8ckQj86z0JwOyVyj89VeZrEiv/LICENSE* -t /app/share/licenses/libghostty-vt/uucode-0.2.0",
                "install -Dm644 uucode-licenses/LICENSE* -t /app/share/licenses/libghostty-vt/uucode-0.2.0",
                "install -Dm644 zig-packages/N-V-__8AAGmZhABbsPJLfbqrh6JTHsXhY6qCaLAQyx25e0XE/LICENSE* -t /app/share/licenses/libghostty-vt/highway",
                "install -Dm644 zig-packages/N-V-__8AAP5JWgCGP_AD0teWpa4krRvE9VPZzvviGdbmN4jI/LICENSE* -t /app/share/licenses/libghostty-vt/wuffs",
                "install -Dm644 zig-packages/translate_c-2.0.0-Q_BUWltOBwBYABF84EUL208pIFeUIwbBs29FmVBaafN5/LICENSE -t /app/share/licenses/libghostty-vt/translate-c"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://release.files.ghostty.org/libghostty-vt/1.0.1/libghostty-vt-1.0.1.tar.gz",
                    "sha256": "333dfce97641ef9b536bb9e08907ad86abaaada50e8f7417b70d9284adef37aa"
                },
                {
                    "type": "archive",
                    "url": "https://release.files.ghostty.org/libghostty-vt/1.0.1/libghostty-vt-1.0.1-deps.tar.gz",
                    "sha256": "91a4e10960a52bf5bf4b15aa2a2cddaff8a89d6cd903d3055bda4fd17de3356d",
                    "dest": "zig-packages"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/jacobsandlund/uucode/1fb73433bba5d93366c57f23ff2e9d7939746500/licenses/LICENSE_unicode",
                    "sha256": "1eda5a3b026870c737b22e8bcd4954338612c790db688242e003f41a4fa95175",
                    "dest": "uucode-licenses"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/jacobsandlund/uucode/1fb73433bba5d93366c57f23ff2e9d7939746500/licenses/LICENSE_Bjoern_Hoehrmann",
                    "sha256": "de219cece932aad5a817bf763393d8d149d378a15d2ad5320e3331eac07626dd",
                    "dest": "uucode-licenses"
                },
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz",
                    "sha256": "1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026",
                    "dest": "zig",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.0/zig-aarch64-linux-0.17.0.tar.xz",
                    "sha256": "9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8",
                    "dest": "zig",
                    "only-arches": [
                        "aarch64"
                    ]
                }
            ]
        },
        {
            "name": "kirigami-app-components",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_EXAMPLES=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/libraries/kirigami-app-components.git",
                    "branch": "master"
                }
            ],
            "post-install": [
                "install -Dm644 LICENSES/* -t /app/share/licenses/kirigami-app-components"
            ]
        },
        {
            "name": "union",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/plasma/union.git"
                }
            ]
        },
        {
            "name": "kwi",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "build*",
                        "CMakeUserPresets.json",
                        "*.user",
                        "*.kate-swp"
                    ]
                }
            ],
            "config-opts": [
                "-DBUILD_KPART=OFF",
                "-DBUILD_TESTING=OFF"
            ]
        }
    ]
}
