Keywords[zh_TW]=終端機;命令提示字元;主控台;指令;命令;
StartupNotify=true
StartupWMClass=@KWI_EXECUTABLE@
X-GNOME-UsesNotifications=true
X-KDE-AuthorizeAction=shell_access
X-KDE-Shortcuts=Ctrl+Alt+T
Actions=NewWindow;NewTab;

