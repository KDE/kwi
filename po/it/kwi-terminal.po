#, kde-format
msgid "Could not write to the terminal: %1"
msgstr "Impossibile scrivere sul terminale: %1"

#: libs/kwi-terminal/src/process/PtyProcess.cpp:270
#, kde-format
msgid "Could not resize the terminal: %1"
msgstr "Impossibile ridimensionare il terminale: %1"

#: libs/kwi-terminal/src/ProcessLaunch.cpp:41
#, kde-format
msgid "A terminal's initial directory must be an absolute path."
msgstr "La cartella iniziale di un terminale deve essere un percorso assoluto."

#: libs/kwi-terminal/src/ProcessLaunch.cpp:47
#, kde-format
msgid "The command contains a null character."
msgstr "Il comando contiene un carattere nullo."

#: libs/kwi-terminal/src/ProcessLaunch.cpp:59
#: libs/kwi-terminal/src/ProcessLaunch.cpp:64
#: libs/kwi-terminal/src/Session.cpp:223
#, kde-format
