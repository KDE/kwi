#: libs/kwi-terminal/src/declarative/Terminal.qml:83
#, kde-format
msgctxt "@info:accessibility"
msgid "Terminal output and command input."
msgstr "ტერმინალის გამოტანა და ბრძანების შეყვანა."

#: libs/kwi-terminal/src/declarative/Terminal.qml:132
#, kde-format
msgctxt "@info:accessibility"
msgid "Terminal bell"
