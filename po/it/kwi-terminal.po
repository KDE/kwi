#, kde-format
msgid "Could not start the host terminal query."
msgstr "Impossibile avviare la query del terminale host."

#: libs/kwi-terminal/src/process/HostProcess.cpp:303
#, kde-format
msgid "Could not start a host helper: %1"
msgstr "Impossibile avviare un helper host: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:309
#, kde-format
msgid "Could not find the system shell on the host."
msgstr "Impossibile trovare la shell di sistema sull'host."

#: libs/kwi-terminal/src/process/HostProcess.cpp:310
#, kde-format
msgid "Could not find the terminal command on the host: %1"
msgstr "Impossibile trovare il comando da terminale sull'host: %1"

#: libs/kwi-terminal/src/process/HostProcess.cpp:354
#, kde-format
msgid "Could not start the host terminal command: %1"
msgstr "Impossibile avviare il comando del terminale host: %1"

#: libs/kwi-terminal/src/process/NativeProcess.cpp:142
#, kde-format
msgid "Could not find executable: %1"
msgstr "Impossibile trovare l'eseguibile : %1"

#: libs/kwi-terminal/src/process/NativeProcess.cpp:183
#, kde-format
msgid "Could not run the terminal command: %1"
msgstr "Impossibile eseguire il comando del terminale: %1"

#: libs/kwi-terminal/src/process/PtyProcess.cpp:67
#, kde-format
msgid "A terminal process is already running."
msgstr "Un processo nel terminale è già in esecuzione."

#: libs/kwi-terminal/src/process/PtyProcess.cpp:158
#, kde-format
msgid ""
"The terminal input queue is full. Wait for the running program before "
"pasting more text."
msgstr ""
"La coda di input del terminale è piena. Attendi il completamento del "
"programma in esecuzione prima di incollare altro testo."

