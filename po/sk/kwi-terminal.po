#, kde-format
msgid "A terminal process is already running."
msgstr "Proces terminálu už beží."

#: libs/kwi-terminal/src/process/PtyProcess.cpp:159
#, kde-format
msgid ""
"The terminal input queue is full. Wait for the running program before "
"pasting more text."
msgstr ""
"Front vstupu terminálu je plný. Pred vložením ďalšieho textu počkajte na "
"bežiaci program."

