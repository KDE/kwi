{
    "id": "org.kde.kwi",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kwi",
    "finish-args": [
        "--device=all",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.kglobalaccel"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/mkspecs",
        "/share/doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libghostty-vt",
            "buildsystem": "simple",
            "build-commands": [
                "ZIG_GLOBAL_CACHE_DIR=\"$PWD/zig-cache\" ./zig/zig build --system \"$PWD/zig-packages\" -fno-sys=simdutf -fno-sys=highway -Demit-lib-vt -Demit-themes=false -Demit-terminfo=false -Dapp-runtime=none -Di18n=false -Doptimize=fast -Dcpu=baseline -Dversion-string=1.4.0 -Dlib-version-string=0.1.0-dev+83fb95624b0439ee660c2679b43b38c8b63769cd --prefix /app",
                "install -Dm644 zig/LICENSE /app/share/licenses/libghostty-vt/zig/LICENSE",
                "install -Dm644 zig/lib/libc/musl/COPYRIGHT /app/share/licenses/libghostty-vt/zig/musl-COPYRIGHT",
                "install -Dm644 simdutf-licenses/* -t /app/share/licenses/libghostty-vt/simdutf",
                "sed -n '/^\\/\\* From$/,/^\\*\\//p' pkg/simdutf/vendor/simdutf.h > /app/share/licenses/libghostty-vt/simdutf/ISA-DETECTION-NOTICE",
                "install -Dm644 zig-packages/uucode-0.2.0-ZZjBPoGFVgCiflJNFc6Io8xzC67B6PA5bUkk4LT0kCxg/LICENSE* -t /app/share/licenses/libghostty-vt/uucode-0.2.0",
                "install -Dm644 zig-packages/uucode-0.2.0-ZZjBPoGFVgCiflJNFc6Io8xzC67B6PA5bUkk4LT0kCxg/licenses/LICENSE* -t /app/share/licenses/libghostty-vt/uucode-0.2.0",
                "install -Dm644 zig-packages/N-V-__8AAGmZhABbsPJLfbqrh6JTHsXhY6qCaLAQyx25e0XE/LICENSE* -t /app/share/licenses/libghostty-vt/highway",
                "install -Dm644 zig-packages/N-V-__8AAP5JWgCGP_AD0teWpa4krRvE9VPZzvviGdbmN4jI/LICENSE* -t /app/share/licenses/libghostty-vt/wuffs"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeload.github.com/ghostty-org/ghostty/tar.gz/refs/tags/v1.4.0",
                    "sha256": "2e2a2516f9bea89a4991ad7c9401b77682eed366387a5b1d7c629472b5d11a43",
                    "archive-type": "tar-gzip"
                },
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz",
                    "sha256": "1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026",
                    "dest": "zig",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://ziglang.org/download/0.17.0/zig-aarch64-linux-0.17.0.tar.xz",
                    "sha256": "9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8",
                    "dest": "zig",
                    "only-arches": [
                        "aarch64"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://deps.files.ghostty.org/uucode-ea62149739404a73c202b48a33bf6dd2af4bd9b0.tar.gz",
                    "sha256": "f37c4071a217853450d084cb9c12b6d4b68f887eb9cb42fe77a84f86056eacbf",
                    "dest": "zig-packages/uucode-0.2.0-ZZjBPoGFVgCiflJNFc6Io8xzC67B6PA5bUkk4LT0kCxg"
                },
                {
                    "type": "archive",
                    "url": "https://deps.files.ghostty.org/highway-66486a10623fa0d72fe91260f96c892e41aceb06.tar.gz",
                    "sha256": "87d4f8893ef4e08f224973608ffebf94268a81380ba79c12e8841968c80aa212",
                    "dest": "zig-packages/N-V-__8AAGmZhABbsPJLfbqrh6JTHsXhY6qCaLAQyx25e0XE"
                },
                {
                    "type": "archive",
                    "url": "https://deps.files.ghostty.org/wuffs-7411f488fe2e2c205c3d3b3d28638b7356522930.tar.gz",
                    "sha256": "17877d346f7988651d6c62e45b2e3b05c86809a6442c5e34612374b2a9719a1c",
                    "dest": "zig-packages/N-V-__8AAP5JWgCGP_AD0teWpa4krRvE9VPZzvviGdbmN4jI"
                },
                {
                    "type": "archive",
                    "url": "https://deps.files.ghostty.org/pixels-12207ff340169c7d40c570b4b6a97db614fe47e0d83b5801a932dcd44917424c8806.tar.gz",
                    "sha256": "55e83b16d091082502bf149bf457f31f42092c5982650e3ffbae7b48871bf11a",
                    "dest": "zig-packages/N-V-__8AADYiAAB_80AWnH1AxXC0tql9thT-R-DYO1gBqTLc"
                },
                {
                    "type": "archive",
                    "url": "https://deps.files.ghostty.org/translate_c-02ff0c523fb92a38939b04d0145c4a9602a74d56.tar.gz",
                    "sha256": "e344433bcce14759529e58ea600e67d7c39846b1775b122f88db7cb4dad58591",
                    "dest": "zig-packages/translate_c-2.0.0-Q_BUWltOBwBYABF84EUL208pIFeUIwbBs29FmVBaafN5"
                },
                {
                    "type": "archive",
                    "url": "https://codeberg.org/ziglang/arocc/archive/d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz",
                    "sha256": "42f5ac4d1fb7c55ad4073dc462b02d485ace4da6d7fc29b35acfa99e28f2cb7d",
                    "dest": "zig-packages/aro-0.0.0-JSD1QtuBNwCASyBtNF3pqTl_W3oAJQGEVyFAtrBSE_Pa"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/simdutf/simdutf/v9.0.0/LICENSE-APACHE",
                    "sha256": "3d34610fc6b5e1b0bfe4e2f36171c2d62c28ef05cb8d704f5a0073be41a43b3d",
                    "dest": "simdutf-licenses"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/simdutf/simdutf/v9.0.0/LICENSE-MIT",
                    "sha256": "fc8dbc04e03ad4efc08a647ffe7f995b811a95bc04c0e85a56d5277c6593fa5f",
                    "dest": "simdutf-licenses"
                }
            ]
        },
        {
            "name": "kirigami-app-components",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_EXAMPLES=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/libraries/kirigami-app-components.git",
                    "branch": "master"
                }
            ],
            "post-install": [
                "install -Dm644 LICENSES/* -t /app/share/licenses/kirigami-app-components"
            ]
        },
        {
            "name": "kwi",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "build*",
                        "CMakeUserPresets.json",
                        "*.user",
                        "*.kate-swp"
                    ]
                }
            ],
            "config-opts": [
                "-DBUILD_KPART=OFF"
            ]
        }
    ]
}
