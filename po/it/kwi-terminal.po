msgstr "L'ambiente del terminale contiene un'assegnazione non valida."

#: libs/kwi-terminal/src/Session.cpp:30
#, kde-format
msgid "Could not allocate terminal state."
msgstr "Impossibile allocare lo stato terminale."

#: libs/kwi-terminal/src/Session.cpp:32
#, kde-format
msgid "Could not capture terminal render state."
msgstr "Impossibile acquisire lo stato di rendering del terminale."

