Keywords[nl]=terminal;shell;console;commando;
Keywords[pt_BR]=terminal;shell;console;comando;
Keywords[sr]=terminal;shell;console;command;терминал;шкољка;конзола;наредба;
Keywords[sr@ijekavian]=terminal;shell;console;command;терминал;шкољка;конзола;наредба;
